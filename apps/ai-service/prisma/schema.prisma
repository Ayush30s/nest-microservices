

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma-clients/ai"
  previewFeatures = ["postgresqlExtensions"]
  
}

datasource db {
  provider   = "postgresql"
  url        = env("AI_DATABASE_URL")
  extensions = [vector]
}

model FitnessKnowledgeChunk {
  id        String                        @id @default(uuid()) @db.Uuid
  content   String?
  metadata  Json?
  embedding Unsupported("vector(1536)")?

  @@map("fitness_knowledge_chunks")
}
